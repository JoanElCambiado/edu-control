<file path="backend/prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMINISTRADOR
  RECEPCION
  USUARIO
}

enum EstadoPrestamo {
  prestado
  devuelto
  atrasado
}

/// Usuario que solicita herramientas en préstamo.
model Usuario {
  id         String       @id @default(uuid()) @db.Uuid
  nombre     String
  rol        Rol
  contrasena String?
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  prestamos  Prestamo[]

  @@map("usuarios")
}

/// Herramienta del catálogo disponible para préstamo.
model Herramienta {
  id           String     @id @default(uuid()) @db.Uuid
  nombre       String
  categoria    String     @default("General")
  estadoFisico String     @default("bueno") @map("estado_fisico")
  descripcion  String?
  cantidad     Int
  disponible   Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  prestamos    Prestamo[]

  @@map("herramientas")
}

/// Proyecto al que se asocia un préstamo (opcional).
model Proyecto {
  id          String     @id @default(uuid()) @db.Uuid
  nombre      String
  descripcion String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  prestamos   Prestamo[]

  @@map("proyectos")
}

/// Préstamo de una herramienta a un usuario, opcionalmente ligado a un proyecto.
model Prestamo {
  id                      String          @id @default(uuid()) @db.Uuid
  herramientaId           String          @map("herramienta_id") @db.Uuid
  usuarioId               String          @map("usuario_id") @db.Uuid
  proyectoId              String?         @map("proyecto_id") @db.Uuid
  fechaSalida             DateTime        @default(now()) @map("fecha_salida")
  fechaDevolucionEsperada DateTime        @map("fecha_devolucion_esperada")
  fechaDevolucionReal     DateTime?       @map("fecha_devolucion_real")
  estado                  EstadoPrestamo  @default(prestado)
  createdAt               DateTime        @default(now()) @map("created_at")
  herramienta             Herramienta     @relation(fields: [herramientaId], references: [id])
  usuario                 Usuario         @relation(fields: [usuarioId], references: [id])
  proyecto                Proyecto?       @relation(fields: [proyectoId], references: [id])

  @@index([herramientaId])
  @@index([usuarioId])
  @@index([proyectoId])
  @@map("prestamos")
}
</file>

<file path="backend/src/index.ts">
import 'dotenv/config'
import express from 'express'
import cors from 'cors'
import { prisma } from './lib/prisma.js'
import usuariosRouter from './routes/usuarios.js'
import herramientasRouter from './routes/herramientas.js'
import prestamosRouter from './routes/prestamos.js'
import syncRouter from './routes/sync.js'

const app = express()

app.use(cors())
app.use(express.json())

app.get('/api/health', (_req, res) => {
  res.json({ status: 'ok' })
})

app.get('/api/sync/usuarios', async (_req, res) => {
  const usuarios = await prisma.usuario.findMany({
    orderBy: { createdAt: 'asc' },
    include: { _count: { select: { prestamos: true } } },
  })
  res.json(usuarios)
})

app.use('/api/usuarios', usuariosRouter)
app.use('/api/herramientas', herramientasRouter)
app.use('/api/prestamos', prestamosRouter)
app.use('/api/sync', syncRouter)

app.use((_req, res) => {
  res.status(404).json({ error: 'Ruta no encontrada' })
})

app.use(
  (err: unknown, _req: express.Request, res: express.Response, _next: express.NextFunction) => {
    console.error(err)
    res.status(500).json({ error: 'Error interno del servidor' })
  },
)

const port = Number(process.env.PORT ?? 4000)

async function main() {
  app.listen(port, () => {
    console.log(`API escuchando en http://localhost:${port}`)
  })
}

main().catch(async (err) => {
  console.error('No se pudo iniciar el servidor:', err)
  await prisma.$disconnect()
  process.exit(1)
})

async function shutdown() {
  await prisma.$disconnect()
  process.exit(0)
}

process.on('SIGINT', shutdown)
process.on('SIGTERM', shutdown)
</file>

